UNLOOP_ENV=development
UNLOOP_HOST=127.0.0.1
UNLOOP_PORT=8787
UNLOOP_DISCOVERY_LEVEL=70
UNLOOP_DATABASE_PATH=data/unloop.db

# Spotify Developer Dashboard client ID. Never commit secrets or tokens.
UNLOOP_SPOTIFY_CLIENT_ID=
UNLOOP_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/v1/connections/spotify/callback

# MusicBrainz requests require a meaningful contact URL/email in the User-Agent.
UNLOOP_MUSICBRAINZ_CONTACT=https://github.com/YOUR_USERNAME/unloop

# Optional independent recommendation source
UNLOOP_LISTENBRAINZ_USERNAME=
# Token is not required for public CF recommendations, but reserved for future feedback/sync.
UNLOOP_LISTENBRAINZ_TOKEN=
